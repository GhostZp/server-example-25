# Testing http requests with Visual Studio Code REST Client extension

## Items (test resource/endpoints using hard-coded mock data)

### get all items
GET http://localhost:3000/api/items

### get item by id
GET http://localhost:3000/api/items/3

### post a new item
POST http://localhost:3000/api/items
content-type: application/json

{
  "name": "Sitruuna"
}

### modify an existing item (by using item's id as a parameter in url)
PUT http://localhost:3000/api/items/3
content-type: application/json

{
  "name": "new name for this item"
}

### delete an item (by id)
DELETE http://localhost:3000/api/items/3


###########################
## Users resource endpoints

### get all users
GET http://localhost:3000/api/users
Authorization: Bearer eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..-v9rQBxZPvDRs3SapqgBQts8W-YtVcYPFJytSg4ReZA

### get user by id
GET http://localhost:3000/api/users/3

### create a new user (user registration)
POST http://localhost:3000/api/users
content-type: application/json

{
  "username": "newusername2",
  "password": "passwordx",
  "email": "newemail2@example.com"
}

### modify an existing user by id
PUT http://localhost:3000/api/users/3
content-type: application/json

{
  "username": "editedname",
  "password": "editedpasswordx",
  "email": "editedmail@example.com"
}

### delete a user (by id)
DELETE http://localhost:3000/api/users/3

### user login
POST http://localhost:3000/api/auth/login
content-type: application/json

{
  "username": "editedname420",
  "password": "editedpasswordx420"
}

### USER INFO

### get my user info
GET http://localhost:3000/api/auth/me
Authorization: Bearer eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..VY33RT_MmRUwxxLw8bAXglkniOn2bcBbPgP7fEC-unI

### Edit user info
PUT http://localhost:3000/api/users/8
Authorization: Bearer eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..-v9rQBxZPvDRs3SapqgBQts8W-YtVcYPFJytSg4ReZA
content-type: application/json

{
  "username": "editedname420",
  "password": "editedpasswordx420",
  "email": "editedmail420@example.com"
}

### DELETE a user by id
DELETE http://localhost:3000/api/users/7

### USER ENTRIES

### post a new entry
POST http://localhost:3000/api/entries
Authorization: Bearer eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..9i9oGexaCBn24vwG4evdb7oywkC7s7jSYW0bXuw_8d4
content-type: application/json

{
 "entry_date": "2025-04-13",
 "mood": "sad",
 "weight": 70,
 "sleep_hours": 4,
 "notes": "nyt loppu testi"
}

### Get user entries
GET http://localhost:3000/api/entries
Authorization: Bearer eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..9i9oGexaCBn24vwG4evdb7oywkC7s7jSYW0bXuw_8d4


### GET entry by entry id
GET http://localhost:3000/api/entries/13


### Edit user entry
PUT http://localhost:3000/api/entries/13
Authorization: Bearer eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..9i9oGexaCBn24vwG4evdb7oywkC7s7jSYW0bXuw_8d4
content-type: application/json

{
 "mood": "sittenkin ok",
 "weight": 70,
 "sleep_hours": 6,
 "notes": "editoidaan"
}


### Delete an entry by entry id
DELETE http://localhost:3000/api/entries/13
